{
  "manifest_version": 3,
  "name": "秋招简历自动填写",
  "version": "0.2.0",
  "description": "填写一次简历，网申表单一键填入（只填不提交）。Moka、Dayee WT、Kuma 已通过脱敏 fixture，规则+LLM 双引擎。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "秋招简历自动填写",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "tabs"],
  "commands": {
    "fill-current-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "在当前页面自动填写简历"
    }
  },
  "host_permissions": ["http://*/*", "https://*/*"]
}
